# Copy to .env.local for local testing (never commit .env.local).
# In production set these in Vercel → Project → Settings → Environment Variables.

# Resend key with "Sending access"
RESEND_API_KEY=

# Sender on a domain verified in Resend
CONTACT_FROM_EMAIL="Saurabh Jaiswal Website <website@aimates.org>"

# Where form messages go (defaults to the email in src/content/site.ts)
CONTACT_TO_EMAIL=saurabh.jaiswal37@gmail.com
